{
  "name": "signal-foundry",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace @signal-foundry/foundry-floor",
    "dev:mcp": "npm run dev --workspace @signal-foundry/mcp-server",
    "dev:all": "bash scripts/dev-local.sh",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run typecheck",
    "seed": "tsx scripts/seed.ts",
    "reset": "tsx scripts/reset.ts",
    "validate:evidence": "node scripts/validate-evidence.mjs evidence",
    "validate:copilot": "node scripts/validate-copilot-package.mjs",
    "validate:workiq-foundry": "node scripts/validate-workiq-foundry.mjs",
    "validate:sensitive": "node scripts/validate-evidence.mjs evidence",
    "audit:final-readiness": "node scripts/audit-final-readiness.mjs",
    "copilot:diagnose": "node scripts/diagnose-copilot-session.mjs",
    "screenshots": "playwright test --config tests/playwright.config.ts",
    "validate": "npm run typecheck && npm run test && npm run validate:evidence && npm run validate:copilot && npm run validate:workiq-foundry && npm run validate:cards",
    "validate:spec": "openspec validate build-copilot-capability-launchpad --strict",
    "validate:full": "npm run validate:spec && npm run validate",
    "container:build": "bash scripts/container-build.sh",
    "container:run": "bash scripts/container-run.sh",
    "smoke:local": "bash scripts/local-smoke.sh",
    "deploy": "bash scripts/deploy.sh",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "validate:cards": "node scripts/sync-adaptive-cards.mjs --check"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/identity": "^4.13.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
