PORT=7071
SIGNAL_FOUNDRY_AUTH_MODE=demo
SIGNAL_FOUNDRY_REGISTRY_MODE=json
SIGNAL_FOUNDRY_REGISTRY_PATH=../../data/signal-foundry-seed.json
SIGNAL_FOUNDRY_COMPANY_NAME=Asteria Dynamics
SIGNAL_FOUNDRY_TENANT_ID=tenant-asteria-dynamics
SIGNAL_FOUNDRY_PROJECT_ID=revenue-ops-launchpad
# For Azure Table registry mirror mode, set SIGNAL_FOUNDRY_REGISTRY_MODE=azure-table
# and provide either SIGNAL_FOUNDRY_STORAGE_ACCOUNT for managed identity or
# SIGNAL_FOUNDRY_STORAGE_CONNECTION_STRING for local development.
SIGNAL_FOUNDRY_STORAGE_ACCOUNT=stsignalfoundry
# Synthetic OAuth boundary: actor assumed for generic bearer tokens in demo mode.
SIGNAL_FOUNDRY_SYNTHETIC_OAUTH_ACTOR_ID=actor-priya
# Advisory AI reasoning (Azure AI Foundry / Azure OpenAI). Advisory only; the
# deterministic risk gate remains the source of truth. Default off locally.
SIGNAL_FOUNDRY_ADVISORY_MODE=off
SIGNAL_FOUNDRY_FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
SIGNAL_FOUNDRY_FOUNDRY_DEPLOYMENT=YOUR-DEPLOYMENT-NAME
SIGNAL_FOUNDRY_FOUNDRY_API_VERSION=2024-10-21
# Prefer managed identity (Cognitive Services OpenAI User role). Set an API key
# only via Key Vault reference in Azure; never commit a real value.
# SIGNAL_FOUNDRY_FOUNDRY_API_KEY=
