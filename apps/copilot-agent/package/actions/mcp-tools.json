{
  "tools": [
    {
      "name": "search_capabilities",
      "description": "Read approved or proposed capabilities by role, department, stage, risk, or keyword. Returns sanitized capability summaries and a correlationId.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tenantId": { "type": "string" },
          "projectId": { "type": "string" },
          "query": { "type": "string" },
          "role": { "type": "string" },
          "department": { "type": "string" },
          "status": { "type": "string" },
          "riskLevel": { "type": "string" }
        },
        "required": ["tenantId", "projectId"]
      },
      "annotations": { "readOnlyHint": true }
    },
    {
      "name": "recommend_capabilities_for_role",
      "description": "Read approved and candidate capabilities for a role from permission-aware or synthetic Work IQ-style summaries.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tenantId": { "type": "string" },
          "projectId": { "type": "string" },
          "role": { "type": "string" },
          "department": { "type": "string" },
          "workSignalSummary": { "type": "string" },
          "maxResults": { "type": "integer", "minimum": 1, "maximum": 10 }
        },
        "required": ["tenantId", "projectId", "role", "department"]
      },
      "annotations": { "readOnlyHint": true }
    },
    {
      "name": "create_capability_proposal",
      "description": "Write a governed capability proposal from a selected use case. Requires explicit user confirmation and idempotencyKey.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tenantId": { "type": "string" },
          "projectId": { "type": "string" },
          "idempotencyKey": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "role": { "type": "string" },
          "department": { "type": "string" },
          "owner": { "type": "string" },
          "intendedAudience": { "type": "string" },
          "inputsRequired": { "type": "array", "items": { "type": "string" } },
          "proposedOutputs": { "type": "array", "items": { "type": "string" } },
          "sourceSummary": { "type": "string" }
        },
        "required": ["tenantId", "projectId", "idempotencyKey", "title", "description", "role", "department", "owner", "intendedAudience", "inputsRequired", "proposedOutputs", "sourceSummary"]
      }
    },
    {
      "name": "score_capability_risk",
      "description": "Write a deterministic risk review for a proposal. Requires explicit user confirmation and idempotencyKey.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tenantId": { "type": "string" },
          "projectId": { "type": "string" },
          "idempotencyKey": { "type": "string" },
          "proposalId": { "type": "string" },
          "dataSensitivity": { "type": "string" },
          "externalSharing": { "type": "string" },
          "automationLevel": { "type": "string" },
          "audienceScope": { "type": "string" },
          "usesCustomerData": { "type": "boolean" },
          "requiresHumanReview": { "type": "boolean" }
        },
        "required": ["tenantId", "projectId", "idempotencyKey", "proposalId", "dataSensitivity", "externalSharing", "automationLevel", "audienceScope", "usesCustomerData", "requiresHumanReview"]
      }
    },
    {
      "name": "submit_capability_review",
      "description": "Write a review queue item for a scored proposal. Requires explicit user confirmation and idempotencyKey.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tenantId": { "type": "string" },
          "projectId": { "type": "string" },
          "idempotencyKey": { "type": "string" },
          "proposalId": { "type": "string" },
          "reviewer": { "type": "string" },
          "dueDate": { "type": "string" }
        },
        "required": ["tenantId", "projectId", "idempotencyKey", "proposalId", "reviewer", "dueDate"]
      }
    },
    {
      "name": "approve_capability",
      "description": "Write reviewer approval for a proposal. Requires reviewer authorization, explicit user confirmation, and idempotencyKey.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tenantId": { "type": "string" },
          "projectId": { "type": "string" },
          "idempotencyKey": { "type": "string" },
          "proposalId": { "type": "string" },
          "reviewer": { "type": "string" },
          "approvalNotes": { "type": "string" }
        },
        "required": ["tenantId", "projectId", "idempotencyKey", "proposalId", "reviewer", "approvalNotes"]
      }
    },
    {
      "name": "reject_capability",
      "description": "Write reviewer rejection for a proposal. Requires reviewer authorization, explicit user confirmation, and idempotencyKey.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tenantId": { "type": "string" },
          "projectId": { "type": "string" },
          "idempotencyKey": { "type": "string" },
          "proposalId": { "type": "string" },
          "reviewer": { "type": "string" },
          "reason": { "type": "string" },
          "nextAction": { "type": "string" }
        },
        "required": ["tenantId", "projectId", "idempotencyKey", "proposalId", "reviewer", "reason", "nextAction"]
      }
    },
    {
      "name": "release_capability",
      "description": "Write release state for an approved capability. Requires reviewer approval, explicit user confirmation, and idempotencyKey.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tenantId": { "type": "string" },
          "projectId": { "type": "string" },
          "idempotencyKey": { "type": "string" },
          "capabilityId": { "type": "string" },
          "releasedBy": { "type": "string" },
          "audience": { "type": "string" },
          "version": { "type": "string" }
        },
        "required": ["tenantId", "projectId", "idempotencyKey", "capabilityId", "releasedBy", "audience", "version"]
      }
    },
    {
      "name": "generate_release_packet",
      "description": "Read an audit-safe release packet for a capability. Returns summaries and metadata only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tenantId": { "type": "string" },
          "projectId": { "type": "string" },
          "capabilityId": { "type": "string" }
        },
        "required": ["tenantId", "projectId", "capabilityId"]
      },
      "annotations": { "readOnlyHint": true }
    },
    {
      "name": "generate_capability_map",
      "description": "Read Signal Atlas graph data for roles, work signals, capabilities, risk gates, reviews, and released workflows.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tenantId": { "type": "string" },
          "projectId": { "type": "string" },
          "filters": { "type": "object", "additionalProperties": true }
        },
        "required": ["tenantId", "projectId"]
      },
      "annotations": { "readOnlyHint": true }
    },
    {
      "name": "list_mcp_activity",
      "description": "Read sanitized MCP activity for the Foundry Floor rail.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tenantId": { "type": "string" },
          "projectId": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
        },
        "required": ["tenantId", "projectId"]
      },
      "annotations": { "readOnlyHint": true }
    }
  ]
}
