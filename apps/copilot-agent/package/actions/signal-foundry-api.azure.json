{
  "schema_version": "v2.4",
  "name_for_human": "Signal Foundry API",
  "namespace": "SignalFoundryApi",
  "description_for_human": "REST fallback for Signal Foundry governed workflow actions.",
  "description_for_model": "Use the Signal Foundry API fallback when the MCP action path is unavailable. It exposes the same governed capability registry, risk review, approval, release, release packet, map, and audit activity operations. Writes require explicit user confirmation, idempotencyKey, tenant/project scope, and authenticated actor context.",
  "functions": [
    {
      "name": "searchCapabilities",
      "description": "Search approved or proposed capabilities.",
      "capabilities": {
        "confirmation": {
          "type": "AdaptiveCard",
          "title": "Search capabilities",
          "body": "Search Signal Foundry capability records?",
          "isNonConsequential": true
        },
        "security_info": {
          "data_handling": [
            "GetPrivateData"
          ]
        }
      }
    },
    {
      "name": "recommendCapabilitiesForRole",
      "description": "Recommend approved and candidate capabilities for a role.",
      "capabilities": {
        "confirmation": {
          "type": "AdaptiveCard",
          "title": "Recommend capabilities",
          "body": "Search role-relevant capability recommendations?",
          "isNonConsequential": true
        },
        "security_info": {
          "data_handling": [
            "GetPrivateData",
            "DataTransform"
          ]
        },
        "response_semantics": {
          "data_path": "$.approvedCapabilities",
          "properties": {
            "title": "$.title",
            "subtitle": "$.status"
          },
          "static_template": {
            "type": "AdaptiveCard",
            "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
            "version": "1.5",
            "body": [
              {
                "type": "TextBlock",
                "text": "${title}",
                "weight": "Bolder",
                "size": "Medium",
                "wrap": true
              },
              {
                "type": "TextBlock",
                "text": "${role} / ${department}",
                "isSubtle": true,
                "wrap": true
              },
              {
                "type": "TextBlock",
                "text": "${description}",
                "wrap": true
              },
              {
                "type": "TextBlock",
                "text": "Risk: ${riskLevel} | Status: ${status} | Version: ${version}",
                "isSubtle": true,
                "size": "Small",
                "wrap": true
              }
            ]
          }
        }
      }
    },
    {
      "name": "createCapabilityProposal",
      "description": "Create a governed proposal from a selected use case.",
      "capabilities": {
        "confirmation": {
          "type": "AdaptiveCard",
          "title": "Create proposal",
          "body": "Create a Signal Foundry capability proposal and audit event?"
        },
        "security_info": {
          "data_handling": [
            "ResourceStateUpdate"
          ]
        },
        "response_semantics": {
          "data_path": "$",
          "properties": {
            "title": "$.proposalId",
            "subtitle": "$.status"
          },
          "static_template": {
            "type": "AdaptiveCard",
            "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
            "version": "1.5",
            "body": [
              {
                "type": "TextBlock",
                "text": "Proposal Created",
                "weight": "Bolder",
                "size": "Medium",
                "wrap": true
              },
              {
                "type": "TextBlock",
                "text": "Proposal ${proposalId} is recorded with status ${status}.",
                "wrap": true
              },
              {
                "type": "TextBlock",
                "text": "Next step: score capability risk, then submit for human review. Releases always require reviewer approval.",
                "isSubtle": true,
                "wrap": true
              },
              {
                "type": "TextBlock",
                "text": "Correlation: ${correlationId}",
                "isSubtle": true,
                "size": "Small",
                "wrap": true
              }
            ]
          }
        }
      }
    },
    {
      "name": "scoreCapabilityRisk",
      "description": "Create a deterministic risk review.",
      "capabilities": {
        "confirmation": {
          "type": "AdaptiveCard",
          "title": "Score risk",
          "body": "Create a risk review record for this proposal?"
        },
        "security_info": {
          "data_handling": [
            "DataTransform",
            "ResourceStateUpdate"
          ]
        },
        "response_semantics": {
          "data_path": "$",
          "properties": {
            "title": "$.riskLevel",
            "subtitle": "$.correlationId"
          },
          "static_template": {
            "type": "AdaptiveCard",
            "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
            "version": "1.5",
            "body": [
              {
                "type": "TextBlock",
                "text": "Risk Gate Verdict",
                "weight": "Bolder",
                "size": "Medium",
                "wrap": true
              },
              {
                "type": "TextBlock",
                "text": "Deterministic verdict: ${upper(riskLevel)}",
                "weight": "Bolder",
                "color": "${if(riskLevel == 'low', 'Good', if(riskLevel == 'medium', 'Warning', 'Attention'))}",
                "wrap": true
              },
              {
                "type": "TextBlock",
                "text": "${rationale}",
                "wrap": true,
                "isSubtle": true
              },
              {
                "type": "TextBlock",
                "text": "Required controls: ${join(requiredControls, '; ')}",
                "wrap": true
              },
              {
                "type": "Container",
                "$when": "${advisory.status == 'available'}",
                "separator": true,
                "items": [
                  {
                    "type": "TextBlock",
                    "text": "Advisory Analysis (${advisory.model})",
                    "weight": "Bolder",
                    "wrap": true
                  },
                  {
                    "type": "TextBlock",
                    "$when": "${advisory.agreesWithGate == false}",
                    "text": "Advisory suggested ${advisory.suggestedRiskLevel} — deterministic gate ruled ${riskLevel}. Gate wins.",
                    "color": "Warning",
                    "weight": "Bolder",
                    "wrap": true
                  },
                  {
                    "type": "TextBlock",
                    "$when": "${advisory.agreesWithGate == true}",
                    "text": "Advisory agrees with the deterministic gate (${riskLevel}).",
                    "color": "Good",
                    "wrap": true
                  },
                  {
                    "type": "TextBlock",
                    "text": "${advisory.summary}",
                    "wrap": true
                  }
                ]
              },
              {
                "type": "TextBlock",
                "$when": "${advisory.status != 'available'}",
                "text": "Advisory unavailable — deterministic verdict stands.",
                "isSubtle": true,
                "wrap": true
              },
              {
                "type": "TextBlock",
                "text": "Advisory only — the deterministic risk gate is the source of truth. Correlation: ${correlationId}",
                "isSubtle": true,
                "size": "Small",
                "wrap": true
              }
            ]
          }
        }
      }
    },
    {
      "name": "submitCapabilityReview",
      "description": "Route a proposal to reviewer queue.",
      "capabilities": {
        "confirmation": {
          "type": "AdaptiveCard",
          "title": "Submit review",
          "body": "Submit this proposal for human review?"
        },
        "security_info": {
          "data_handling": [
            "ResourceStateUpdate"
          ]
        }
      }
    },
    {
      "name": "approveCapability",
      "description": "Approve a proposal as a reviewer.",
      "capabilities": {
        "confirmation": {
          "type": "AdaptiveCard",
          "title": "Approve capability",
          "body": "Approve this proposal as the authenticated reviewer?"
        },
        "security_info": {
          "data_handling": [
            "ResourceStateUpdate"
          ]
        }
      }
    },
    {
      "name": "rejectCapability",
      "description": "Reject a proposal with reason and next action.",
      "capabilities": {
        "confirmation": {
          "type": "AdaptiveCard",
          "title": "Reject capability",
          "body": "Reject this proposal and record the reason?"
        },
        "security_info": {
          "data_handling": [
            "ResourceStateUpdate"
          ]
        }
      }
    },
    {
      "name": "releaseCapability",
      "description": "Release an approved capability.",
      "capabilities": {
        "confirmation": {
          "type": "AdaptiveCard",
          "title": "Release capability",
          "body": "Release this approved capability and create a release packet?"
        },
        "security_info": {
          "data_handling": [
            "ResourceStateUpdate"
          ]
        }
      }
    },
    {
      "name": "generateReleasePacket",
      "description": "Generate an audit-safe release packet.",
      "capabilities": {
        "confirmation": {
          "type": "AdaptiveCard",
          "title": "Generate release packet",
          "body": "Generate an audit-safe release packet?",
          "isNonConsequential": true
        },
        "security_info": {
          "data_handling": [
            "GetPrivateData",
            "DataTransform"
          ]
        },
        "response_semantics": {
          "data_path": "$.releasePacket",
          "properties": {
            "title": "$.version",
            "subtitle": "$.owner"
          },
          "static_template": {
            "type": "AdaptiveCard",
            "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
            "version": "1.5",
            "body": [
              {
                "type": "TextBlock",
                "text": "Release Packet ${version}",
                "weight": "Bolder",
                "size": "Medium",
                "wrap": true
              },
              {
                "type": "FactSet",
                "facts": [
                  {
                    "title": "Owner",
                    "value": "${owner}"
                  },
                  {
                    "title": "Reviewer",
                    "value": "${reviewer}"
                  },
                  {
                    "title": "Audience",
                    "value": "${approvedAudience}"
                  },
                  {
                    "title": "Released",
                    "value": "${releasedAt}"
                  }
                ]
              },
              {
                "type": "TextBlock",
                "text": "Approved sources: ${join(approvedSourceTypes, '; ')}",
                "wrap": true,
                "isSubtle": true
              },
              {
                "type": "TextBlock",
                "text": "Usage guidance: ${join(usageGuidance, '; ')}",
                "wrap": true,
                "isSubtle": true
              },
              {
                "type": "TextBlock",
                "text": "Human review enforced before release. Correlation: ${correlationId}",
                "isSubtle": true,
                "size": "Small",
                "wrap": true
              }
            ],
            "actions": [
              {
                "type": "Action.OpenUrl",
                "title": "Open Foundry Floor",
                "url": "https://red-coast-0b0c14e0f.7.azurestaticapps.net"
              }
            ]
          }
        }
      }
    },
    {
      "name": "generateCapabilityMap",
      "description": "Generate Signal Atlas graph data.",
      "capabilities": {
        "confirmation": {
          "type": "AdaptiveCard",
          "title": "Generate capability map",
          "body": "Generate audit-safe Signal Atlas map data?",
          "isNonConsequential": true
        },
        "security_info": {
          "data_handling": [
            "GetPrivateData",
            "DataTransform"
          ]
        }
      }
    },
    {
      "name": "listMcpActivity",
      "description": "List sanitized MCP activity records.",
      "capabilities": {
        "confirmation": {
          "type": "AdaptiveCard",
          "title": "List MCP activity",
          "body": "List sanitized MCP activity records?",
          "isNonConsequential": true
        },
        "security_info": {
          "data_handling": [
            "GetPrivateData"
          ]
        }
      }
    }
  ],
  "runtimes": [
    {
      "type": "OpenApi",
      "auth": {
        "type": "OAuthPluginVault",
        "reference_id": "SIGNAL_FOUNDRY_ENTRA_OAUTH_REFERENCE_ID"
      },
      "spec": {
        "url": "https://ca-signal-foundry-mcp.agreeablemushroom-5fb088be.eastus2.azurecontainerapps.io/openapi.json",
        "progress_style": "ShowUsageWithInput"
      }
    }
  ]
}
